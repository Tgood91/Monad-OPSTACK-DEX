# Get a free Project ID at https://cloud.reown.com
VITE_PROJECT_ID=YOUR_PROJECT_ID_HERE

VITE_APP_NAME=Bushido-dApp
VITE_APP_DESCRIPTION=Best-price DEX across Base, Monad, Optimism, Ink, Unichain
VITE_APP_URL=http://localhost:5173
VITE_APP_ICON=https://velodrome.finance/favicon.ico

# --- Quote source API keys (optional) ---
# 0x: https://dashboard.0x.org (free tier available). This is the only
# browser-side key — it is baked into the bundle at build time.
VITE_0X_API_KEY=

# 1inch, Zerion, Uniswap and Coinbase keys are SERVER-SIDE only —
# see server/.env.example. Never put them here (VITE_* values ship to the browser).
# Velodrome, Aerodrome, KyberSwap, LI.FI, and Velora need no keys.

# Operations alerts (high-severity errors are emailed via Resend)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
