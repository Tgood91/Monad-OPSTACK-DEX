# Copy this to .env in your project root and fill in values.
# NEVER commit a real .env — keep it out of git.
# The Relay API key itself lives in the secure vault, not here.

# Monad RPC endpoint (testnet or mainnet)
MONAD_RPC_URL=

# Deployer wallet — prefer a dedicated dev key, never your main wallet
PRIVATE_KEY=

# Relay API key — optional (Relay's API works without one).
# Stored in the secure vault; reference it by name, don't paste it here.
RELAY_API_KEY=
