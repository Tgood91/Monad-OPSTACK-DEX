<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen, before the TWA splash drawn by Chrome. -->
    <style name="Theme.Bushido" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bushido_background</item>
        <item name="android:statusBarColor">@color/bushido_background</item>
        <item name="android:navigationBarColor">@color/bushido_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/bushido_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
