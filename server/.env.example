# Server env (NEVER prefix with VITE_ — these stay server-side)
PORT=3001

# CDP API key (Coinbase Developer Platform). Optional if the coinbase CLI
# on this machine already holds a key (server falls back to ~/.config/coinbase/config.json).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Comma-separated allowed origins for the frontend in production, e.g.
# CORS_ORIGIN=https://dex.example.com
# Leave unset for same-origin dev.
CORS_ORIGIN=

# Live price stream: products to subscribe on wss://advanced-trade-ws.coinbase.com
# (public ticker channel, no key). /api/coinbase/prices uses the stream when
# fresh (<20s) and falls back to REST otherwise. Leave unset for the default.
WS_PRODUCTS=BTC-USD,ETH-USD
