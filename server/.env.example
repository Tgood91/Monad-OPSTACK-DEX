# Server env (NEVER prefix with VITE_ — these stay server-side)
PORT=3001

# CDP API key (Coinbase Developer Platform). Optional if the coinbase CLI
# on this machine already holds a key (server falls back to ~/.config/coinbase/config.json).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Comma-separated allowed origins for the frontend in production, e.g.
# CORS_ORIGIN=https://dex.example.com
# Leave unset for same-origin dev.
CORS_ORIGIN=

# Live price stream: products to subscribe on wss://advanced-trade-ws.coinbase.com
# (public ticker channel, no key). /api/coinbase/prices uses the stream when
# fresh (<20s) and falls back to REST otherwise. Leave unset for the default.
WS_PRODUCTS=BTC-USD,ETH-USD

# Zerion swap quotes: https://developers.zerion.io
ZERION_API_KEY=

# Uniswap Trading API: https://developers.uniswap.org
UNISWAP_API_KEY=
# 1inch swap API: https://portal.1inch.dev
ONEINCH_API_KEY=
# If these are unset, the server falls back to the Secure Vault (authd socket),
# which only exists on the original dev machine. Override its path if needed:
# JARVIS_AUTHD_SOCK=/run/hatch/auth/authd.sock

# Bushido dashboard: BushidoVirtueRegistry address on Base. Unset = neutral 0.5 scores.
BUSHIDO_REGISTRY=
BASE_RPC=https://mainnet.base.org

# Set to 1 when running behind a reverse proxy (nginx, Cloudflare, Render…)
# so the rate limiter sees real client IPs. Leave unset for direct connections.
TRUST_PROXY=
